{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations", "type": "dashboard"}]},
  "editable": true,
  "id": null,
  "uid": "newapi-ops-v1",
  "title": "NewAPI 运维视图（CTO / Ops）",
  "tags": ["newapi", "ops", "cto"],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "实时业务指标",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "title": "请求 QPM（每分钟请求数）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "pointSize": 4, "showPoints": "auto"},
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "time_series",
        "rawSql": "SELECT date_trunc('minute', to_timestamp(created_at)) AS time, COUNT(*)::int AS qpm FROM logs WHERE type = 2 AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint AND created_at <= EXTRACT(EPOCH FROM $__timeTo())::bigint GROUP BY 1 ORDER BY 1;"
      }]
    },
    {
      "id": 3,
      "title": "请求延迟 P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 0, "lineWidth": 2},
          "unit": "ms"
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "time_series",
        "rawSql": "SELECT date_trunc('minute', to_timestamp(created_at)) AS time, PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY use_time)::float * 1000 AS p50_ms, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY use_time)::float * 1000 AS p95_ms, PERCENTILE_CONT(0.99) WITHIN GROUP (ORDER BY use_time)::float * 1000 AS p99_ms FROM logs WHERE type = 2 AND use_time > 0 AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint AND created_at <= EXTRACT(EPOCH FROM $__timeTo())::bigint GROUP BY 1 ORDER BY 1;"
      }]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Vendor / 渠道",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Vendor 错误率（24h）",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "错误率"},
            "properties": [
              {"id": "unit", "value": "percentunit"},
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "gradient"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.01},
                {"color": "red", "value": 0.05}
              ]}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "footer": {"show": true, "reducer": ["mean"], "fields": ["错误率"]}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COALESCE(channels.name, NULLIF(logs.channel_name, ''), '未知 ' || logs.channel_id::text) AS \"渠道\", COUNT(*)::int AS \"总请求\", COUNT(*) FILTER (WHERE logs.type = 5)::int AS \"错误数\", (COUNT(*) FILTER (WHERE logs.type = 5)::float / GREATEST(COUNT(*), 1)) AS \"错误率\", MAX(logs.use_time)::int AS \"最大延迟(秒)\" FROM logs LEFT JOIN channels ON logs.channel_id = channels.id WHERE logs.created_at >= EXTRACT(EPOCH FROM now() - interval '24 hours')::bigint GROUP BY 1 HAVING COUNT(*) > 5 ORDER BY \"错误率\" DESC;"
      }]
    },
    {
      "id": 12,
      "title": "Vendor 调用量分布",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"orientation": "horizontal", "showValue": "always"}
        }
      },
      "options": {"legend": {"displayMode": "hidden"}, "tooltip": {"mode": "single"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COALESCE(channels.name, NULLIF(logs.channel_name, ''), '未知 ' || logs.channel_id::text) AS \"渠道\", COUNT(*)::int AS \"调用次数\" FROM logs LEFT JOIN channels ON logs.channel_id = channels.id WHERE logs.type = 2 AND logs.created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint GROUP BY 1 ORDER BY 2 DESC LIMIT 15;"
      }]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Token 经济性 + 模型分布",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Token 消费时序（按模型）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 30, "stacking": {"mode": "normal", "group": "A"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "values": ["max", "mean"]}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', to_timestamp(created_at)) AS time, model_name AS metric, SUM(prompt_tokens + completion_tokens)::int AS tokens FROM logs WHERE type = 2 AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint AND created_at <= EXTRACT(EPOCH FROM $__timeTo())::bigint GROUP BY 1, 2 ORDER BY 1;"
      }]
    },
    {
      "id": 22,
      "title": "Top 10 模型调用量",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "总 token"},
            "properties": [{"id": "unit", "value": "short"}, {"id": "custom.cellOptions", "value": {"type": "gauge"}}]
          }
        ]
      },
      "options": {"showHeader": true},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT model_name AS \"模型\", COUNT(*)::int AS \"调用次数\", SUM(prompt_tokens)::int AS \"输入 token\", SUM(completion_tokens)::int AS \"输出 token\", SUM(prompt_tokens + completion_tokens)::int AS \"总 token\", AVG(use_time)::int AS \"平均耗时(秒)\" FROM logs WHERE type = 2 AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint AND created_at <= EXTRACT(EPOCH FROM $__timeTo())::bigint AND model_name IS NOT NULL AND model_name != '' GROUP BY 1 ORDER BY 5 DESC LIMIT 10;"
      }]
    },
    {
      "id": 30,
      "type": "row",
      "title": "用户行为",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Top 用户消费排行",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {"defaults": {"custom": {"align": "left"}}},
      "options": {"showHeader": true},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT username AS \"用户\", COUNT(*)::int AS \"请求数\", SUM(prompt_tokens + completion_tokens)::int AS \"消耗 token\", SUM(quota)::int AS \"扣费(配额)\", COUNT(DISTINCT model_name)::int AS \"使用模型数\" FROM logs WHERE type = 2 AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint GROUP BY 1 ORDER BY 3 DESC LIMIT 20;"
      }]
    },
    {
      "id": 32,
      "title": "DAU / 周活 (历史 30 天)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 30, "lineWidth": 2}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "time_series",
        "rawSql": "SELECT date_trunc('day', to_timestamp(created_at)) AS time, COUNT(DISTINCT user_id)::int AS dau FROM logs WHERE type = 2 AND created_at >= EXTRACT(EPOCH FROM now() - interval '30 days')::bigint GROUP BY 1 ORDER BY 1;"
      }]
    }
  ]
}
