{
  "annotations": {
    "list": [{
      "builtIn": 1,
      "datasource": {"type": "grafana", "uid": "-- Grafana --"},
      "enable": true,
      "hide": true,
      "iconColor": "rgba(0, 211, 255, 1)",
      "name": "Annotations & Alerts",
      "type": "dashboard"
    }]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "newapi-compliance-v1",
  "title": "NewAPI 安全合规视图（Compliance Officer）",
  "tags": ["newapi", "compliance", "security"],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "概览",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "title": "今日活跃用户",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COUNT(DISTINCT user_id)::int AS dau FROM logs WHERE created_at >= EXTRACT(EPOCH FROM CURRENT_DATE)::bigint AND type = 2;"
      }]
    },
    {
      "id": 3,
      "title": "本月累计 token",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "center",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COALESCE(SUM(prompt_tokens + completion_tokens), 0)::bigint AS tokens FROM logs WHERE created_at >= EXTRACT(EPOCH FROM date_trunc('month', CURRENT_DATE))::bigint AND type = 2;"
      }]
    },
    {
      "id": 4,
      "title": "DLP 拦截总数（7 天）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 50}
          ]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COALESCE(COUNT(*), 0)::int AS hits FROM audit_events WHERE event_type = 'dlp_hit' AND created_at >= EXTRACT(EPOCH FROM now() - interval '7 days')::bigint;"
      }]
    },
    {
      "id": 5,
      "title": "异常登录失败（24h）",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 5},
            {"color": "red", "value": 50}
          ]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background", "graphMode": "none",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COALESCE(COUNT(*), 0)::int AS fails FROM audit_events WHERE event_type IN ('login_fail', 'login_lockout', 'login_blocked') AND created_at >= EXTRACT(EPOCH FROM now() - interval '24 hours')::bigint;"
      }]
    },
    {
      "id": 10,
      "type": "row",
      "title": "DLP 命中分析（结构化 audit_events 表）",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false
    },
    {
      "id": 11,
      "title": "DLP 命中按规则分布（7 天）",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]},
        "pieType": "donut",
        "tooltip": {"mode": "single"},
        "reduceOptions": {"values": false, "calcs": ["sum"], "fields": ""}
      },
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT rule_id AS metric, COUNT(*)::int AS hits FROM audit_events WHERE event_type = 'dlp_hit' AND created_at >= EXTRACT(EPOCH FROM now() - interval '7 days')::bigint AND rule_id != '' GROUP BY 1 ORDER BY 2 DESC LIMIT 15;"
      }]
    },
    {
      "id": 12,
      "title": "DLP 命中时序（按动作堆叠）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', to_timestamp(created_at)) AS time, action AS metric, COUNT(*)::int AS hits FROM audit_events WHERE event_type = 'dlp_hit' AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint AND created_at <= EXTRACT(EPOCH FROM $__timeTo())::bigint GROUP BY 1, 2 ORDER BY 1;"
      }]
    },
    {
      "id": 20,
      "type": "row",
      "title": "管理员敏感操作 audit",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "collapsed": false
    },
    {
      "id": 21,
      "title": "近 30 天敏感操作清单（删 log / 改密 / 改配额 / 看密钥）",
      "type": "table",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 15},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {"defaults": {"custom": {"align": "left", "displayMode": "auto"}}},
      "options": {"showHeader": true, "footer": {"show": false}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT to_timestamp(created_at) AT TIME ZONE 'Asia/Shanghai' AS \"时间\", event_type AS \"事件\", severity AS \"级别\", username AS \"操作人\", ip AS \"IP\", detail AS \"详情\" FROM audit_events WHERE event_type IN ('log_delete', 'channel_key_read', 'quota_change', 'user_status_change', 'ssrf_block') AND created_at >= EXTRACT(EPOCH FROM now() - interval '30 days')::bigint ORDER BY created_at DESC LIMIT 100;"
      }]
    },
    {
      "id": 30,
      "type": "row",
      "title": "登录安全事件 (M-4 触发)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "collapsed": false
    },
    {
      "id": 31,
      "title": "登录失败次数（按用户名 Top 10）",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"orientation": "horizontal", "showValue": "always"}
        }
      },
      "options": {"legend": {"displayMode": "hidden"}, "tooltip": {"mode": "single"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "table",
        "rawSql": "SELECT COALESCE(NULLIF(username, ''), 'unknown') AS \"用户\", COUNT(*)::int AS \"失败次数\" FROM audit_events WHERE event_type IN ('login_fail', 'login_lockout', 'login_blocked') AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint GROUP BY 1 ORDER BY 2 DESC LIMIT 10;"
      }]
    },
    {
      "id": 32,
      "title": "锁定 + 阻断事件时序",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "datasource": {"type": "postgres", "uid": "newapi-pg"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "postgres", "uid": "newapi-pg"},
        "format": "time_series",
        "rawSql": "SELECT date_trunc('hour', to_timestamp(created_at)) AS time, event_type AS metric, COUNT(*)::int AS events FROM audit_events WHERE event_type IN ('login_lockout', 'login_blocked', 'lockout_cleared') AND created_at >= EXTRACT(EPOCH FROM $__timeFrom())::bigint AND created_at <= EXTRACT(EPOCH FROM $__timeTo())::bigint GROUP BY 1, 2 ORDER BY 1;"
      }]
    }
  ]
}
